@using Recommendations_engine

<div class="game-card" @onclick="SelectGame">

    <span class="game-rank">#@Rank</span>

    <div class="game-cover">
        @if (!string.IsNullOrWhiteSpace(Game.Header_image))
        {
            <img src="@Game.Header_image"
                 alt="@Game.Name"
                 loading="lazy" />
        }
    </div>

    <div class="game-info">
        <h3>@Game.Name</h3>
        <span>@Game.Release_date</span>
    </div>

</div>

@code {
    [Parameter]
    public game_card Game { get; set; } = default!;

    [Parameter]
    public int Rank { get; set; }

    [Parameter]
    public EventCallback<game_card> OnGameSelected { get; set; }

    private async Task SelectGame()
    {
        await OnGameSelected.InvokeAsync();
    }
}
