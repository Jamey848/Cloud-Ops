@using Recommendations_engine
@using System.Net.Http.Json
@using CloudOpsBlazor.Components.Game_details
@inject HttpClient Http
@inject ILogger<GameDetails> Logger

@if (IsVisible && Game != null)
{
    <div class="game-details-overlay">
        <div class="game-details-window">

            <button class="close-button"
                    @onclick="OnClose">
                &times;
            </button>

            @if (IsLoading)
            {
                <p>Loading game details...</p>
            }
            else if (GameDTO != null)
            {
                <GameHero GameDTO="GameDTO" />

                <GameStatistics GameDTO="GameDTO" />

                <GamePopularity GameDTO="GameDTO" />

                <GamePrice GameDTO="GameDTO" />

                <GamePlatforms GameDTO="GameDTO" />

                <GameScreenshots GameDTO="GameDTO" />

                <GameMetadata GameDTO="GameDTO" />
            }
            else
            {
                <p>Unable to load game details.</p>
            }

        </div>
    </div>
}

@code {
    private DetailedGameDto? GameDTO;
    private bool IsLoading;

    [Parameter] public game_card? Game { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsVisible || Game == null)
        {
            GameDTO = null;
            return;
        }

        IsLoading = true;

        try
        {
            GameDTO = await Http.GetFromJsonAsync<DetailedGameDto>(
                $"api/Games/details/{Game.Appid}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load game details");
            GameDTO = null;
        }
        finally
        {
            IsLoading = false;
        }
    }
}



